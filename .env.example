# ---------------------------------------------------------------------------
# Example environment configuration for the vlog application.
# Copy this file to `.env` and replace the placeholder values with real ones.
# Never commit the real `.env` file — it is ignored by git.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://vloguser:vlogpass@localhost:5432/vlogdb

# Secret used to sign short-lived JWT access tokens. Use a long random string.
JWT_SECRET=your-secret-key-here

# Secret used to sign long-lived JWT refresh tokens. Must differ from JWT_SECRET.
JWT_REFRESH_SECRET=your-refresh-secret-here

# Application runtime environment: development | test | production.
NODE_ENV=development

# Port the API server listens on.
PORT=8080

# Name of the AWS S3 bucket where uploaded vlog videos are stored.
AWS_S3_BUCKET=vlog-videos

# AWS region the S3 bucket lives in.
AWS_REGION=us-east-1

# AWS access key ID used to authenticate S3 requests.
AWS_ACCESS_KEY_ID=your-access-key

# AWS secret access key paired with the access key ID above.
AWS_SECRET_ACCESS_KEY=your-secret-key

# Cloudflare zone ID used for CDN cache purging / configuration.
CLOUDFLARE_ZONE_ID=your-zone-id

# Redis connection string used for caching and background job queues.
REDIS_URL=redis://localhost:6379
