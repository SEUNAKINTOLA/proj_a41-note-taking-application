// Prisma schema for the vlog application.
// Defines the User, Vlog, Folder, and SyncConflict models backed by PostgreSQL.
// Run `npx prisma migrate dev` to create/apply migrations and `npx prisma generate`
// to regenerate the type-safe Prisma Client.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  password_hash String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  vlogs   Vlog[]
  folders Folder[]
}

model Vlog {
  id                 String    @id @default(uuid()) @db.Uuid
  user_id            String    @db.Uuid
  user               User      @relation(fields: [user_id], references: [id])
  folder_id          String?   @db.Uuid
  folder             Folder?   @relation(fields: [folder_id], references: [id])
  title              String
  description        String?
  video_url          String?
  thumbnail_url      String?
  transcription_text String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  deleted_at         DateTime?

  @@index([user_id])
  @@index([folder_id])
  @@index([created_at])
  @@index([deleted_at])
  @@index([transcription_text], type: Gin)
}

model Folder {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  user       User     @relation(fields: [user_id], references: [id])
  name       String
  sort_order Int      @default(0)
  created_at DateTime @default(now())

  vlogs Vlog[]

  @@index([user_id])
}

model SyncConflict {
  id            String    @id @default(uuid()) @db.Uuid
  vlog_id       String    @db.Uuid
  user_id       String    @db.Uuid
  device_a_data Json
  device_b_data Json
  created_at    DateTime  @default(now())
  resolved_at   DateTime?
}
